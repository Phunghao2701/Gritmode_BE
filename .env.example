# ==============================================================================
# 1. APPLICATION RUNTIME & SERVER
# ==============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SUPPORT_HOTLINE="0326 747 206"

# ==============================================================================
# 2. DATABASE CONFIGURATION (LOCAL POSTGRESQL DOCKER)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gritmode_db
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/gritmode_db

# ==============================================================================
# 3. REDIS CACHE (LOCAL REDIS DOCKER)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# 4. AUTHENTICATION & SECURITY (JWT & GOOGLE OAUTH)
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d
COOKIE_REFRESH_MAX_AGE=2592000000

CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
REFRESH_TOKEN=your_google_refresh_token

# ==============================================================================
# 5. OBJECT STORAGE (MINIO / S3 COMPATIBLE)
# ==============================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=gritmode-products
MINIO_PUBLIC_URL=http://localhost:9000

# ==============================================================================
# 6. TRANSACTIONAL EMAIL SERVICES
# ==============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
RESEND_API_KEY=re_your_resend_api_key

# ==============================================================================
# 7. PAYMENT GATEWAY (PAYOS)
# ==============================================================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:5173/payment/result
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# ==============================================================================
# 8. DATABASE WEB GUI (PGADMIN 4)
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=admin@gritmode.vn
PGADMIN_DEFAULT_PASSWORD=password123
