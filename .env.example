# Application Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=1d
COOKIE_REFRESH_MAX_AGE=2592000000

# Database & Cache (Localhost if running on host, or container name in docker)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/gritmode_db
REDIS_URL=redis://localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=gritmode-products
MINIO_PUBLIC_URL=http://localhost:9000

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
BREVO_API_KEY=

# Cloud OAuth
GOOGLE_CLIENT_ID=
