# ==========================================
# Stage 1: Build & Dependencies
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Install build tools for native addons (e.g. sharp)
RUN apk add --no-cache python3 make g++

COPY package*.json ./

# Install production dependencies only
RUN npm ci --omit=dev

# ==========================================
# Stage 2: Minimal Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Install curl for container health check
RUN apk add --no-cache curl libc6-compat

ENV NODE_ENV=production
ENV PORT=5000

# Copy installed production dependencies from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY package*.json ./
COPY server.js ./
COPY src/ ./src/
COPY database/ ./database/
COPY scripts/ ./scripts/

# Ensure directory permissions for non-root user 'node'
RUN chown -R node:node /app

# Switch to non-root user for security hardening
USER node

EXPOSE 5000

# Container healthcheck testing /api/v1/health
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5000}/api/v1/health || exit 1

CMD ["node", "server.js"]
