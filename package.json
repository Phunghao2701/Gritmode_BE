{
  "name": "gritmode_be",
  "version": "1.0.0",
  "description": "Backend API for the Gritmode clothing store",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/**/*.test.js",
    "test:controller": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/unit/controllers/*.test.js",
    "test:service": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/unit/services/*.test.js",
    "test:unit": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/unit/**/*.test.js",
    "test:integration": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/integration/*.test.js",
    "test:coverage": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 --experimental-test-coverage tests/**/*.test.js",
    "test:smoke": "node --import ./tests/setup/test-env.js --test --test-isolation=none --test-concurrency=1 tests/integration/health.route.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:schema:inspect": "node scripts/inspect-schema.js",
    "db:schema:check": "node scripts/check-repository-reads.js",
    "db:media:report": "node scripts/report-media-legacy.js",
      "db:media:reconcile": "node scripts/reconcile-media-assets.js",
    "db:sync:administrative": "node scripts/sync-administrative-data.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.17.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "google-auth-library": "^10.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.6",
    "pg": "8.21.0",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "supertest": "7.2.2"
  },
  "private": true
}
