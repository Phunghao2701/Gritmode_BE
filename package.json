{
  "name": "gritmode_be",
  "version": "1.0.0",
  "description": "Backend API for the Gritmode clothing store",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --env-file=.env --test --test-isolation=none tests/**/*.test.js",
    "test:controller": "node --env-file=.env --test --test-isolation=none tests/unit/controllers/*.test.js",
    "test:service": "node --env-file=.env --test --test-isolation=none tests/unit/services/*.test.js",
    "test:unit": "node --env-file=.env --test --test-isolation=none tests/unit/**/*.test.js",
    "test:integration": "node --env-file=.env --test --test-isolation=none tests/integration/*.test.js",
    "test:coverage": "node --env-file=.env --test --test-isolation=none --experimental-test-coverage tests/**/*.test.js",
    "test:smoke": "node --env-file=.env --test --test-isolation=none tests/integration/health.route.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:sync:supabase": "node scripts/migrate-from-supabase.js",
    "db:migrate:images": "node scripts/migrate-images-to-minio.js",
    "db:schema:inspect": "node scripts/inspect-schema.js",
    "db:schema:check": "node scripts/check-repository-reads.js",
    "db:seed:products": "node scripts/seed-demo-products.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.17.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "google-auth-library": "^10.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.6",
    "pg": "8.21.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "supertest": "7.2.2"
  },
  "private": true
}
